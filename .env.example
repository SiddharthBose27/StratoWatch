# StratoWatch Frontend Environment Variables
#
# Copy this file to .env.local for local overrides (never commit .env.local).
#
# VITE_API_BASE_URL
#   The base URL of the StratoWatch FastAPI backend.
#
#   Local development (default — no env var needed):
#     The Vite dev proxy handles /api -> http://127.0.0.1:8000 automatically.
#
#   Production (Vercel deployment):
#     Set this in the Vercel project dashboard under Settings > Environment Variables.
#     Example: https://your-backend.railway.app
#
# VITE_API_BASE_URL=https://your-backend.railway.app
